# ==============================================================================
# CleftPath Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit the actual .env file or production credentials to source control.
# ==============================================================================

# ==============================================================================
# 1. SERVER-ONLY SECRETS (MANDATORY FOR PRODUCTION BACKEND)
# ==============================================================================
# PostgreSQL Connection URL (must include asyncpg driver and pgvector extension on DB)
DATABASE_URL=postgresql+asyncpg://cleftpath_admin:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/cleftpath_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cleftpath_db
POSTGRES_USER=cleftpath_admin
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# JWT Signing Secret (Generate using: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_SECURE_256_BIT_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API Key (Server-side RAG & PathGuide only; NEVER expose to client)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Object Storage (S3 / Cloudflare R2 / MinIO) - Optional
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=REPLACE_WITH_STORAGE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STORAGE_SECRET_KEY
S3_BUCKET_NAME=cleftpath-documents
S3_REGION=us-east-1

# Redis Cache / Rate Limiter URL
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# 2. SERVER NON-SECRET CONFIGURATION
# ==============================================================================
# Application Mode ('development', 'staging', 'production')
ENVIRONMENT=development
PROJECT_NAME="CleftPath"
API_V1_STR="/api/v1"
DEBUG=true

# Server Network Binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list of frontend URLs)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Cookie Security (MUST be set to COOKIE_SECURE=true in production with HTTPS)
COOKIE_NAME=cleftpath_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ==============================================================================
# 3. SAFE PUBLIC FRONTEND VARIABLES (INJECTED AT BUILD TIME)
# ==============================================================================
# Backend API base URL consumed by the React SPA client
VITE_API_BASE_URL=http://localhost:8000/api/v1
