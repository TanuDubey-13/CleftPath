# ==============================================================================
# CleftPath Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit the actual .env file or production credentials to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CleftPath"
API_V1_STR="/api/v1"
DEBUG=true

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# PostgreSQL Database (with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cleftpath_db
POSTGRES_USER=cleftpath_admin
POSTGRES_PASSWORD=devpassword_replace_in_env
DATABASE_URL=postgresql+asyncpg://cleftpath_admin:devpassword_replace_in_env@localhost:5432/cleftpath_db

# Redis Cache & Rate Limiter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_in_local_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=cleftpath-documents
S3_REGION=us-east-1

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
